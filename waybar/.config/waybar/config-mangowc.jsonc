// -*- mode: jsonc -*-
// Minimal DWM-style Waybar for MangoWC/DWL tags.
{
    "layer": "top",
    "position": "top",
    "height": 26,
    "spacing": 0,
    "reload_style_on_change": true,

    "modules-left": [
        "dwl/tags"
    ],
    "modules-center": [
        "dwl/window"
    ],
    "modules-right": [
        "pulseaudio",
        "network",
        "custom/tailscale",
        "cpu",
        "memory",
        "backlight",
        "battery",
        "custom/profile",
        "custom/powermenu",
        "clock"
    ],

    "dwl/tags": {
        "num-tags": 10
    },

    "dwl/window": {
        "format": "{}",
        "max-length": 70
    },

    "pulseaudio": {
        "format": "VOL {volume}%",
        "format-muted": "VOL --",
        "on-click": "pavucontrol",
        "on-scroll-up": "pamixer -i 2",
        "on-scroll-down": "pamixer -d 2",
        "tooltip-format": "{desc} | {volume}%"
    },

    "network": {
        "format-wifi": "NET {signalStrength}%",
        "format-ethernet": "NET ETH",
        "format-disconnected": "NET --",
        "tooltip-format-wifi": "{essid} | {ipaddr}\nSignal: {signalStrength}%\nDown: {bandwidthDownBits}\nUp: {bandwidthUpBits}",
        "tooltip-format-ethernet": "{ifname} | {ipaddr}/{cidr}\nDown: {bandwidthDownBits}\nUp: {bandwidthUpBits}",
        "tooltip-format-disconnected": "No network connection",
        "interval": 5
    },

    "custom/tailscale": {
        "exec": "~/.config/waybar/scripts/tailscale-exit-node.sh",
        "return-type": "json",
        "interval": 10,
        "on-click": "~/.config/waybar/scripts/tailscale-exit-node.sh --menu",
        "signal": 9,
        "format": "TS {}"
    },

    "cpu": {
        "interval": 2,
        "format": "CPU {usage}%",
        "tooltip-format": "CPU: {usage}%\n{avg_frequency} GHz"
    },

    "memory": {
        "interval": 5,
        "format": "MEM {percentage}%",
        "tooltip-format": "RAM: {used:0.1f}/{total:0.1f} GiB\nSwap: {swapUsed:0.1f}/{swapTotal:0.1f} GiB"
    },

    "backlight": {
        "format": "BRT {percent}%",
        "tooltip-format": "Brightness: {percent}%",
        "on-scroll-up": "brightnessctl s +2%",
        "on-scroll-down": "brightnessctl s 2%-"
    },

    "battery": {
        "states": {
            "full": 100,
            "good": 80,
            "warning": 30,
            "critical": 15
        },
        "format": "BAT {capacity}%",
        "format-discharging": "BAT {capacity}% {power:.1f}W",
        "format-charging": "AC {capacity}% {power:.1f}W",
        "format-plugged": "AC {capacity}%",
        "format-full": "BAT FULL",
        "format-alt": "BAT {time}",
        "interval": 10,
        "tooltip-format": "Battery: {capacity}%\n{timeTo}\nPower: {power:.1f}W"
    },

    "custom/profile": {
        "exec": "~/.config/waybar/scripts/power-profile.sh",
        "return-type": "json",
        "interval": 5,
        "on-click": "~/.config/waybar/scripts/power-profile.sh cycle",
        "exec-on-event": true,
        "format": "PROF {}"
    },

    "custom/powermenu": {
        "format": "PWR",
        "on-click": "~/.config/waybar/scripts/power-menu.sh",
        "tooltip-format": "Power menu"
    },

    "clock": {
        "format": "{:%a %b %d %H:%M}",
        "format-alt": "{:%Y-%m-%d %H:%M:%S}",
        "interval": 30,
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    }
}
